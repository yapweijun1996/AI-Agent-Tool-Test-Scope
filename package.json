{
  "name": "agent-test-scope",
  "version": "0.1.0",
  "description": "Deterministic, local-first verification planning for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-test-scope": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "SPEC.md",
    "DESIGN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "coverage": "npm run build && node scripts/coverage-check.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "capability:check": "npm run build && node scripts/capability-check.mjs",
    "smoke:pack": "npm run build && node scripts/smoke-pack.mjs",
    "benchmark:check": "npm run build && node scripts/benchmark-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
